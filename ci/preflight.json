{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown",
    "preflight_order",
    "preflight_runner_options"
  ],
  "function_exceptions": {},
