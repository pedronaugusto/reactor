    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "reactor"
      ]
    }
  },
  "ziglint_exceptions": "ci/ziglint-exceptions.json",
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ]
  ],
  "unreachable_exceptions": "ci/unreachable-exceptions.json",
